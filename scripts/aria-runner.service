[Unit]
Description=ARIA — Autonomous Research Intelligence Agent (Pipeline)
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
Environment=PATH=__DIR__/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=__DIR__/.venv/bin/python runner.py
Restart=on-failure
RestartSec=60
MemoryHigh=250M
MemoryMax=400M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
