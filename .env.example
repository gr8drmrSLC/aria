# ARIA — Environment Variables
# Copy this file to .env and fill in your values before running
# Never commit .env — only .env.example belongs in the repo

# ── Required ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Optional — Pipeline ───────────────────────────────────────────────────────
ARIA_MODEL=claude-sonnet-4-6           # Claude model to use for analysis
ARIA_DB_PATH=data/aria.db              # SQLite database path
ARIA_LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
ARIA_NOVELTY_THRESHOLD=7               # Min score (0-10) to flag a paper as high-novelty

# ── Optional — Anomaly Thresholds ────────────────────────────────────────────
ARIA_VOLUME_SPIKE=1.5                  # Multiplier over baseline to trigger volume spike
ARIA_NOVELTY_BURST_PCT=0.30           # Fraction of papers that must be high-novelty (0.0-1.0)
ARIA_SIGNIFICANCE_SURGE=1.3           # Multiplier over baseline avg novelty to trigger surge
ARIA_CROSS_DOMAIN_MIN=3               # Min cross-domain papers to trigger cross-domain trigger

# ── Optional — Dashboard ─────────────────────────────────────────────────────
ARIA_DASHBOARD_PORT=5051              # Port for the Flask dashboard (nginx proxies this)
ARIA_DASHBOARD_URL=https://aria-agent.duckdns.org  # Public URL (used by export_static.py)

# ── AWS — S3 backup (backup_db.sh) ───────────────────────────────────────────
# Leave unset to use instance role or ~/.aws/credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=us-east-2

# ── DuckDNS — dynamic DNS (scripts/duckdns_update.sh) ────────────────────────
DUCKDNS_TOKEN=your_duckdns_token_here
DUCKDNS_DOMAIN=aria-agent
EC2_IP=your_ec2_ip_here
