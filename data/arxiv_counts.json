   "RO&AI": "cat:cs.RO AND cat:cs.AI",
   "RO&ML": "cat:cs.RO AND (cat:cs.LG OR cat:stat.ML)",
   "total": "all arXiv"
  },
  "source": "arXiv API opensearch:totalResults"
 }
